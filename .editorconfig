# Syncarr editor config — match across editors so reformatting churn stays low
# until a real linter/formatter is wired up.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{js,cjs,mjs}]
quote_type = single
max_line_length = 120

[*.json]
quote_type = double
